# Copy to .env locally and supply your own values. Never commit the filled file.
# MAC of the Windows PC you explicitly authorize for remote waking.
UU_WOL_ALLOWED_MAC=REPLACE_WITH_APPROVED_TARGET_MAC
# NAS/LAN interface (for example br0 on some QNAP hosts), not Docker bridge/WAN/lo.
UU_WOL_LAN_IFACE=REPLACE_WITH_CONFIRMED_LAN_INTERFACE
