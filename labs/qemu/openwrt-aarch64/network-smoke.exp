#!/usr/bin/expect -f

set timeout 180

if {$argc != 1} {
    puts stderr "usage: network-smoke.exp <kernel-image>"
    exit 2
}

set image [lindex $argv 0]

spawn qemu-system-aarch64 \
    -machine virt \
    -cpu cortex-a57 \
    -m 256 \
    -smp 2 \
    -nographic \
    -no-reboot \
    -kernel $image \
    -netdev user,id=lan0,restrict=on \
    -device virtio-net-pci,netdev=lan0 \
    -netdev user,id=wan0 \
    -device virtio-net-pci,netdev=wan0

set prompt_ready 0
expect {
    -re {Please press Enter to activate this console\.} {
        send "\r"
    }
    -re {root@[^:\r\n]+:[^\r\n]*# ?} {
        set prompt_ready 1
    }
    timeout {
        puts stderr "OpenWrt console did not become ready"
        exit 10
    }
    eof {
        puts stderr "QEMU exited before OpenWrt console became ready"
        exit 11
    }
}

if {!$prompt_ready} {
    expect {
        -re {root@[^:\r\n]+:[^\r\n]*# ?} {}
        timeout {
            puts stderr "OpenWrt root prompt did not appear after activating console"
            exit 12
        }
        eof {
            puts stderr "QEMU exited before root prompt appeared"
            exit 13
        }
    }
}

# The console is available well before netifd finishes building br-lan on
# armsr. Wait for the real LAN bridge to become operational before borrowing
# eth1 as the isolated test WAN; otherwise late network init can tear down the
# temporary DHCP route underneath the HTTPS probe.
send "until test -r /sys/class/net/br-lan/operstate && grep -q '^up$' /sys/class/net/br-lan/operstate; do sleep 1; done; echo LAB_NETWORK_SETTLED_\"OK\"\r"
set timeout 75
expect {
    -re {LAB_NETWORK_SETTLED_OK} {}
    timeout { puts stderr "OpenWrt late network initialization did not settle"; exit 20 }
}
set timeout 180

send "ip link show eth1 >/dev/null 2>&1 && echo LAB_WAN_NIC_\"OK\"\r"
expect {
    -re {LAB_WAN_NIC_OK} {}
    timeout { puts stderr "second virtio WAN interface was not detected"; exit 21 }
}

send "ip link set eth1 up; udhcpc -i eth1 -q -n -t 5 >/tmp/udhcpc-wan.log 2>&1; ip -4 addr show dev eth1 | grep -q 'inet ' && echo LAB_DHCP_\"OK\"\r"
expect {
    -re {LAB_DHCP_OK} {}
    timeout { puts stderr "QEMU user-network DHCP did not configure eth1"; exit 22 }
}

send "command -v wget >/dev/null 2>&1 && echo LAB_WGET_\"OK\"\r"
expect {
    -re {LAB_WGET_OK} {}
    timeout { puts stderr "OpenWrt initramfs does not provide wget"; exit 23 }
}

# Keep the signed package URL out of Actions logs. Only validate that the
# official API can be reached over HTTPS and returns the expected flat fields.
send "rm -f /tmp/uu-api.json; wget -qO /tmp/uu-api.json 'https://router.uu.163.com/api/plugin?type=openwrt-aarch64' && grep -q '\"status\":\"ok\"' /tmp/uu-api.json && grep -q '\"md5\":\"' /tmp/uu-api.json && grep -q '\"url\":\"http' /tmp/uu-api.json && echo LAB_UU_API_\"OK\"\r"
expect {
    -re {LAB_UU_API_OK} {}
    timeout { puts stderr "NetEase openwrt-aarch64 API HTTPS validation failed"; exit 24 }
}

send "rm -f /tmp/uu-api.json /tmp/udhcpc-wan.log; echo LAB_NETWORK_\"OK\"\r"
expect {
    -re {LAB_NETWORK_OK} {}
    timeout { puts stderr "network completion marker missing"; exit 25 }
}

send "reboot -f\r"
set timeout 30
expect {
    eof {}
    timeout {
        puts stderr "QEMU did not exit after forced reboot with -no-reboot"
        exit 26
    }
}

exit 0
