#!/bin/sh /etc/rc.common
# managed_by=uu-remote-wol-router-helper-mips-beta
START=96
STOP=09
USE_PROCD=1
PROG=/usr/lib/uu-mips-wol-helper/boot.sh
STOPPER=/usr/lib/uu-mips-wol-helper/stop.sh

start_service() {
    procd_open_instance
    procd_set_param command "$PROG"
    # Startup network may be late. Never rapidly respawn indefinitely.
    procd_set_param respawn 3600 15 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    sh "$STOPPER"
}
